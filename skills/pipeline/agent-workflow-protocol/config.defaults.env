# Default workflow configuration. Plain shell assignments: agents read it, scripts/lib.sh sources it.
# Do not edit this file in a consuming repository. Put overrides in .agents/docs/github-agent-workflow.env
# (the repository's copy wins). Skills refer to these names.

# --- Exploring ---
EXPLORE_ISSUE_CAP=10            # file at most this many new issues per run
EXPLORE_DEDUPE_CLOSED_DAYS=30   # "recently closed" window for duplicate search
EXPLORE_LOG_LOOKBACK_DAYS=14    # how far back Exploring reads the run log

# --- Leases (how long a claim stays valid without renewal; relative shell durations like "1 hour") ---
LEASE_TTL_TRIAGE="1 hour"       # Grooming
LEASE_TTL_IMPLEMENT="3 hours"   # Implementing
LEASE_TTL_PR="1 hour"           # Shepherding, Reviewing

# --- Batch sizes: max items one run handles before it stops ---
GROOM_BATCH=5
IMPLEMENT_BATCH=1
SHEPHERD_BATCH=3
REVIEW_BATCH=3

# --- Escalation limits ---
MAX_SHEPHERD_ATTEMPTS=3         # consecutive Shepherding fix attempts, reset by any handoff
MAX_REVIEW_ROUNDS=3             # Reviewing runs that did not merge

# --- Repository ---
PR_BASE_BRANCH="main"           # agent PRs target this branch
MERGE_METHOD="squash"           # squash | merge | rebase
HUMAN_REVIEWER=""               # who escalation requests review from; empty = do not request one
BUILD_CMD=""                    # build command run before opening a PR; empty = skip (CI is the gate)
GIT_HOOKS_PATH=""               # if set, `git config core.hooksPath` to this before committing
REPO_GUIDANCE="AGENTS.md"       # space-separated files holding the repository's contributor rules
