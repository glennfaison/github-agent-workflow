{
  "name": "github-agent-workflow",
  "version": "1.10.0",
  "private": true,
  "description": "Agent skills that run a GitHub repository's issue-to-merge pipeline unattended",
  "license": "MIT",
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
    "lint": "node scripts/lint-files.mjs --all",
    "pretest": "node scripts/check-hooks.mjs",
    "test": "bash tests/lib.test.sh && node --test tests/helpers.test.mjs tests/lint.test.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "check": "npm run lint && npm run validate && npm run check-plugin-version && npm test",
    "hooks:check": "node scripts/check-hooks.mjs",
    "prepare": "husky || true",
    "link": "bash scripts/link-skills.sh",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check"
  },
  "dependencies": {
    "mattpocock-skills": "1.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*": "node scripts/lint-files.mjs"
  }
}
